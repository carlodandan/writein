{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "write-in",
  "version": "1.0.0",
  "identifier": "com.carlodandan.writein",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WriteIn — Offline Novel & Writing Manager",
        "width": 1280,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "WriteIn",
        "url": "/splashscreen.html",
        "width": 540,
        "height": 380,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
